#!/usr/bin/env bash
# chrome-debug — Chrome con tu sesión real + CDP, accesible desde cyxpc-b.
#
# El mismo script vive en las dos máquinas y cambia de papel solo:
#   think-x1 (hay Chrome)    → servidor: levanta Chrome y el túnel hacia cyxpc-b.
#   cyxpc-b  (no hay Chrome) → cliente: diagnostica el CDP del túnel y, si falta
#                              algo, intenta arreglarlo corriendo esto en think-x1.
#
# Uso:
#   chrome-debug [URL] [--insecure] [--fresh] [--port N] [--no-tunnel]
#                         levanta lo que falte, reusa lo que sirva y verifica
#                         de punta a punta. Con URL y Chrome ya vivo, abre la URL
#                         en una pestaña nueva.
#   chrome-debug status   diagnóstico sin tocar nada (exit 0 = todo bien)
#   chrome-debug restart  reinicia Chrome (p. ej. si se colgó) y el túnel
#   chrome-debug stop     cierra Chrome y el túnel
#   chrome-debug clean    stop + borra la copia del perfil (tiene tus cookies)
#
#   --insecure   añade --ignore-certificate-errors (certs internos, *.ts.net)
#   --fresh      re-copia el perfil real (cookies nuevas); cierra antes tu Chrome
#   --no-tunnel  solo Chrome local, sin túnel
#
# Exit: 0 ok · 1 error · 3 pantalla de think-x1 bloqueada · 4 Tailscale SSH pide aprobación
#
# Por qué cada cosa:
# - Chrome 136+ rechaza --remote-debugging-port sobre el perfil por defecto → copia.
# - CDP solo en 127.0.0.1; el túnel `ssh -R` lo publica en el loopback de cyxpc-b.
# - Chrome y túnel corren como unidades transitorias de `systemd --user`
#   (chrome-cdp, chrome-cdp-tunnel): sobreviven a la terminal y a Tailscale SSH,
#   que mata los procesos de su sesión al salir aunque haya setsid.
# - El túnel se reconecta solo (Restart=always), va por Tailscale (cyxpc-b-ts,
#   sirve arriba y abajo) y NO usa el ControlMaster: así ni lo tumban ni tumba
#   tus otras sesiones ssh.
# - Si la pantalla de think-x1 se bloquea, light-locker cambia de VT, Xorg deja de
#   atender a la sesión :0 y Chrome se congela (CDP da timeout) hasta desbloquear.

set -uo pipefail

PORT="${CHROME_CDP_PORT:-9222}"
PROFILE_SRC="${CHROME_PROFILE_SRC:-$HOME/.config/google-chrome}"
PROFILE_DST="${CHROME_DEBUG_PROFILE:-/tmp/chrome-debug-profile}"
TUNNEL_TO="${CHROME_CDP_TUNNEL_TO:-cyxpc-b-ts}"       # servidor: a dónde va el túnel
CHROME_HOST="${CHROME_CDP_HOST:-arlf0@think-x1}"       # cliente: dónde vive Chrome
U_CHROME=chrome-cdp
U_TUNNEL=chrome-cdp-tunnel
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ControlMaster=no -o ControlPath=none
          -o ServerAliveInterval=15 -o ServerAliveCountMax=3)
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

say()  { printf '%s\n' "$*"; }
ok()   { printf '  ✅ %s\n' "$*"; }
bad()  { printf '  ❌ %s\n' "$*"; }
warn() { printf '  ⚠️  %s\n' "$*"; }
die()  { local c="$1"; shift; printf 'chrome-debug: %s\n' "$*" >&2; exit "$c"; }

# --- CDP --------------------------------------------------------------------
# ok | hung (escucha pero no contesta: Chrome congelado) |
# closed (algo acepta y corta: túnel arriba sin Chrome detrás) | down (nadie escucha)
cdp_probe() {
  curl -s -o /dev/null --max-time "${1:-4}" "http://127.0.0.1:$PORT/json/version"
  case $? in 0) echo ok ;; 28) echo hung ;; 7) echo down ;; *) echo closed ;; esac
}
cdp_info() {
  local v n
  v=$(curl -s --max-time 4 "http://127.0.0.1:$PORT/json/version" | grep -o '"Browser": *"[^"]*"' | cut -d'"' -f4)
  n=$(curl -s --max-time 4 "http://127.0.0.1:$PORT/json/list" | grep -c '"type": *"page"')
  echo "$v, $n pestaña(s)"
}
cdp_open() {   # abre URL en pestaña nueva de un Chrome ya vivo
  curl -s -o /dev/null --max-time 5 -X PUT "http://127.0.0.1:$PORT/json/new?$1"
}

# --- Papel de esta máquina ----------------------------------------------------
find_chrome() {
  [ -n "${CHROME_BIN:-}" ] && { echo "$CHROME_BIN"; return; }
  local b
  for b in google-chrome google-chrome-stable chromium chromium-browser; do
    command -v "$b" >/dev/null 2>&1 && { command -v "$b"; return; }
  done
}

# =============================================================================
#  SERVIDOR (think-x1)
# =============================================================================

# Sesión X11 del usuario (la del escritorio, no las de ssh).
gui_session() {
  local id uid user _
  while read -r id uid user _; do
    [ "$user" = "$USER" ] || continue
    [ "$(loginctl show-session "$id" -p Type --value 2>/dev/null)" = x11 ] && { echo "$id"; return; }
  done < <(loginctl list-sessions --no-legend 2>/dev/null)
}
session_locked() {   # 0 = bloqueada / en otra VT
  local s="$1"
  [ "$(loginctl show-session "$s" -p Active --value)" = no ] ||
  [ "$(loginctl show-session "$s" -p LockedHint --value)" = yes ]
}
# Entorno gráfico copiado de un proceso de esa sesión, para que Chrome arranque
# igual (DISPLAY, Xauthority, D-Bus/keyring para descifrar cookies) aunque este
# script se corra por ssh.
gui_env() {
  local s="$1" p e
  for p in $(pgrep -u "$USER" -o -x openbox) $(pgrep -u "$USER"); do
    e=$(tr '\0' '\n' < "/proc/$p/environ" 2>/dev/null) || continue
    grep -qx "XDG_SESSION_ID=$s" <<<"$e" && grep -q '^DISPLAY=' <<<"$e" || continue
    grep -E '^(DISPLAY|XAUTHORITY|DBUS_SESSION_BUS_ADDRESS|XDG_CURRENT_DESKTOP|DESKTOP_SESSION|XDG_SESSION_ID|XDG_SESSION_TYPE|GNOME_KEYRING_CONTROL|LANG)=' <<<"$e"
    return 0
  done
  return 1
}

# Procesos chrome que usan la copia del perfil. Se filtra por comm: pgrep -f también
# atrapa shells cuyo texto contiene la ruta.
chrome_pids() {
  local p
  for p in $(pgrep -f -- "--user-data-dir=$PROFILE_DST --remote-debugging-port"); do
    case "$(ps -o comm= -p "$p" 2>/dev/null)" in chrome|chromium*) echo "$p" ;; esac
  done
}
chrome_port() {   # puerto CDP del Chrome que ya usa la copia (Chrome reescribe su cmdline: usar ps)
  local p; p=$(chrome_pids | head -1); [ -n "$p" ] || return 0
  ps -o args= -p "$p" | grep -o -- '--remote-debugging-port=[0-9]*' | head -1 | cut -d= -f2
}
unit_active()  { systemctl --user is-active --quiet "$1"; }
tunnel_pid()   { systemctl --user show -p MainPID --value "$U_TUNNEL" 2>/dev/null; }
# Túneles a mano (`ssh -N -R 9222:...` en una terminal) que no son la unidad.
stray_tunnels() {
  local p main; main=$(tunnel_pid)
  for p in $(pgrep -f -- "ssh .*-R *$PORT:127.0.0.1:$PORT"); do
    [ "$p" != "$main" ] && [ "$(ps -o comm= -p "$p")" = ssh ] && echo "$p"
  done
}

stop_chrome() {
  systemctl --user stop "$U_CHROME" 2>/dev/null
  local p; p=$(chrome_pids)
  if [ -n "$p" ]; then
    kill $p 2>/dev/null
    for _ in $(seq 1 20); do [ -z "$(chrome_pids)" ] && break; sleep 0.25; done
    p=$(chrome_pids); [ -n "$p" ] && kill -9 $p 2>/dev/null
  fi
}
stop_tunnel() {
  systemctl --user stop "$U_TUNNEL" 2>/dev/null
  local p; p=$(stray_tunnels); [ -n "$p" ] && kill $p 2>/dev/null
}

copy_profile() {
  [ -d "$PROFILE_SRC" ] || die 1 "no existe el perfil real $PROFILE_SRC (abre Chrome y loguéate una vez)"
  [ -e "$PROFILE_SRC/SingletonLock" ] &&
    warn "tu Chrome principal está abierto: la copia de cookies puede quedar inconsistente"
  say "  copiando perfil → $PROFILE_DST (sin cachés)…"
  rsync -a --delete \
    --exclude='*Cache*' --exclude='GPUCache' --exclude='GrShaderCache' --exclude='ShaderCache' \
    --exclude='component_crx_cache' --exclude='Crashpad' --exclude='Singleton*' \
    "$PROFILE_SRC/" "$PROFILE_DST/"
}

start_chrome() {   # $1 = sesión, $2 = URL, $3 = insecure
  local s="$1" url="$2" insecure="$3" chrome envargs=() line
  chrome=$(find_chrome)
  while IFS= read -r line; do envargs+=(--setenv="$line"); done < <(gui_env "$s")
  [ ${#envargs[@]} -gt 0 ] || die 1 "no encontré el entorno gráfico de la sesión $s (¿no hay escritorio abierto?)"
  rm -f "$PROFILE_DST"/Singleton* 2>/dev/null
  local args=(--user-data-dir="$PROFILE_DST" --remote-debugging-port="$PORT"
              --remote-debugging-address=127.0.0.1
              --no-first-run --no-default-browser-check --disable-gpu)
  [ "$insecure" = 1 ] && args+=(--ignore-certificate-errors --test-type)
  args+=("${url:-about:blank}")
  systemctl --user reset-failed "$U_CHROME" 2>/dev/null
  systemd-run --user --quiet --collect --unit="$U_CHROME" "${envargs[@]}" "$chrome" "${args[@]}" ||
    die 1 "systemd-run no pudo lanzar Chrome"
  for _ in $(seq 1 60); do [ "$(cdp_probe 2)" = ok ] && return 0; sleep 0.5; done
  journalctl --user -u "$U_CHROME" -n 8 --no-pager -o cat >&2
  die 1 "Chrome arrancó pero el CDP no respondió en 30 s (log arriba)"
}

start_tunnel() {
  local p; p=$(stray_tunnels)
  if [ -n "$p" ]; then
    say "  cerrando túnel manual viejo (pid $p)"; kill $p 2>/dev/null
    for _ in $(seq 1 20); do [ -z "$(stray_tunnels)" ] && break; sleep 0.25; done
  fi
  systemctl --user reset-failed "$U_TUNNEL" 2>/dev/null
  # ExitOnForwardFailure: si el puerto sigue tomado en cyxpc-b por una sesión muerta,
  # ssh sale y systemd reintenta cada 5 s. cyxpc-b-ts lo atiende Tailscale SSH: suelta
  # la sesión vieja en cuanto le llega el cierre (o un RST al intentar escribirle).
  systemd-run --user --quiet --collect --unit="$U_TUNNEL" \
    -p Restart=always -p RestartSec=5 \
    ssh -N "${SSH_OPTS[@]}" -o ExitOnForwardFailure=yes \
        -R "$PORT:127.0.0.1:$PORT" "$TUNNEL_TO" ||
    die 1 "systemd-run no pudo lanzar el túnel"
}
remote_probe() {   # CDP visto desde cyxpc-b
  ssh "${SSH_OPTS[@]}" "$TUNNEL_TO" \
    "curl -s -o /dev/null --max-time 4 http://127.0.0.1:$PORT/json/version; echo \$?" 2>/dev/null |
    tail -1 | { read -r c; case "$c" in 0) echo ok ;; 28) echo hung ;; 7) echo down ;; '') echo unreachable ;; *) echo closed ;; esac; }
}

server_status() {
  local s st rc=0
  say "chrome-debug status (think-x1)"
  s=$(gui_session)
  if [ -z "$s" ]; then bad "no hay sesión gráfica: Chrome no puede abrir"; rc=1
  elif session_locked "$s"; then bad "pantalla BLOQUEADA (sesión $s en otra VT): Chrome congelado hasta que desbloquees"; rc=3
  else ok "escritorio activo (sesión $s)"; fi

  st=$(cdp_probe)
  case "$st" in
    ok)   ok "Chrome + CDP local: $(cdp_info)" ;;
    hung) bad "Chrome vivo pero el CDP no contesta (congelado)"; [ $rc = 0 ] && rc=1 ;;
    *)    if [ -n "$(chrome_pids)" ]; then bad "hay Chrome con el perfil copia pero sin CDP en :$PORT"
          else bad "Chrome de debug no está corriendo"; fi; [ $rc = 0 ] && rc=1 ;;
  esac

  if unit_active "$U_TUNNEL"; then
    ok "túnel → $TUNNEL_TO activo ($(systemctl --user show -p NRestarts --value "$U_TUNNEL") reconexiones)"
  else bad "túnel caído (unidad $U_TUNNEL inactiva)"; [ $rc = 0 ] && rc=1; fi
  [ -n "$(stray_tunnels)" ] && warn "hay túnel(es) manual(es) viejo(s): pid $(stray_tunnels | tr '\n' ' ')"

  st=$(remote_probe)
  case "$st" in
    ok)          ok "CDP visible en cyxpc-b (127.0.0.1:$PORT)" ;;
    unreachable) bad "no llego a $TUNNEL_TO por ssh"; [ $rc = 0 ] && rc=1 ;;
    *)           bad "CDP en cyxpc-b: $st"; [ $rc = 0 ] && rc=1 ;;
  esac
  return $rc
}

server_up() {
  local url="$1" insecure="$2" fresh="$3" tunnel="$4" s st
  s=$(gui_session)
  [ -n "$s" ] || die 1 "no hay sesión gráfica de $USER en think-x1: inicia sesión en el escritorio"

  st=$(cdp_probe)
  if [ "$st" = hung ] && ! session_locked "$s"; then
    sleep 3; st=$(cdp_probe 6)   # recién desbloqueada: dale un momento
  fi
  if [ "$st" = hung ]; then
    session_locked "$s" &&
      die 3 "la pantalla de think-x1 está bloqueada y Chrome está congelado: desbloquéala (no hace falta relanzar)"
    die 1 "Chrome está vivo pero colgado (no es el bloqueo). Reinícialo: chrome-debug restart"
  fi

  if [ "$fresh" = 1 ]; then
    [ "$st" = ok ] && say "  --fresh: cierro el Chrome de debug para re-copiar el perfil"
    stop_chrome; copy_profile; st=down
  elif [ ! -d "$PROFILE_DST" ]; then
    copy_profile
  fi

  if [ "$st" = ok ]; then
    ok "Chrome ya estaba vivo: $(cdp_info)"
    [ -n "$url" ] && cdp_open "$url" && ok "abierta en pestaña nueva: $url"
  else
    session_locked "$s" && die 3 "la pantalla de think-x1 está bloqueada: desbloquéala y vuelve a correr"
    # Nunca cerrar por nuestra cuenta un Chrome que ya existe: puede tener trabajo abierto.
    local otro; otro=$(chrome_port)
    [ -n "$otro" ] && [ "$otro" != "$PORT" ] &&
      die 1 "la copia del perfil ya la usa otro Chrome de debug en el puerto $otro (usa --port $otro, o chrome-debug stop)"
    [ -n "$(chrome_pids)" ] &&
      die 1 "hay un Chrome de debug corriendo pero su CDP no responde. Si no tiene nada que perder: chrome-debug restart"
    say "  lanzando Chrome (unidad $U_CHROME)…"
    start_chrome "$s" "$url" "$insecure"
    ok "Chrome + CDP en 127.0.0.1:$PORT: $(cdp_info)"
  fi

  [ "$tunnel" = 1 ] || { say "  (sin túnel, por --no-tunnel)"; return 0; }
  if ! unit_active "$U_TUNNEL" || [ -n "$(stray_tunnels)" ]; then
    say "  levantando túnel → $TUNNEL_TO (unidad $U_TUNNEL)…"
    stop_tunnel; start_tunnel
  fi
  for i in $(seq 1 20); do
    sleep 3   # ExitOnForwardFailure tarda un instante en tumbar un túnel que no pudo abrir el puerto
    st=$(remote_probe); [ "$st" = ok ] && unit_active "$U_TUNNEL" && break
    [ "$i" = 4 ] && say "  esperando a que cyxpc-b suelte el puerto de una sesión vieja…"
  done
  if [ "$st" = ok ]; then ok "túnel listo: CDP visible en cyxpc-b → http://127.0.0.1:$PORT"
  else bad "el túnel no quedó (desde cyxpc-b: $st). Log: journalctl --user -u $U_TUNNEL -n 20"; return 1; fi
}

# =============================================================================
#  CLIENTE (cyxpc-b): sin Chrome local, todo llega por el túnel
# =============================================================================

client_explain() {
  case "$1" in
    ok)     ok "CDP por el túnel: $(cdp_info)" ;;
    down)   bad "nada escucha en 127.0.0.1:$PORT → el túnel desde think-x1 está caído" ;;
    closed) bad "el túnel está, pero detrás no hay Chrome → Chrome de think-x1 cerrado" ;;
    hung)   bad "Chrome no contesta → casi seguro la pantalla de think-x1 está bloqueada (desbloquéala)" ;;
  esac
}
# Corre chrome-debug en think-x1. Tailscale SSH a veces pide aprobación por navegador.
client_remote() {
  local q out rc
  q=$(printf ' %q' "$@")
  say "  intentando en $CHROME_HOST…"
  out=$(timeout 90 ssh -o BatchMode=yes -o ConnectTimeout=8 "$CHROME_HOST" ".local/bin/chrome-debug$q" 2>&1)
  rc=$?
  if grep -q 'login.tailscale.com' <<<"$out"; then
    say "  Tailscale SSH pide aprobación. Ábrela y vuelve a correr chrome-debug:"
    say "    $(grep -o 'https://login.tailscale.com[^ ]*' <<<"$out" | head -1)"
    say "  (o corre chrome-debug directo en think-x1)"
    return 4
  fi
  [ $rc = 124 ] && { say "$out"; bad "think-x1 no respondió a tiempo (¿suspendida o fuera de la tailnet?)"; return 1; }
  sed 's/^/  [think-x1] /' <<<"$out"
  return $rc
}

client_main() {
  local cmd="$1"; shift
  local st; st=$(cdp_probe)
  case "$cmd" in
    status)
      say "chrome-debug status (cyxpc-b → think-x1)"
      client_explain "$st"; [ "$st" = ok ] ;;
    up)
      if [ "$st" = ok ] && [ "$FRESH" = 0 ]; then
        client_explain ok
        [ -n "$URL" ] && cdp_open "$URL" && ok "abierta en pestaña nueva: $URL"
        return 0
      fi
      [ "$st" = ok ] || client_explain "$st"
      client_remote "$@" || return $?
      st=$(cdp_probe); client_explain "$st"; [ "$st" = ok ] ;;
    *)
      client_remote "$cmd" "$@" ;;
  esac
}

# =============================================================================

CMD=up; URL=""; INSECURE=0; FRESH=0; TUNNEL=1; PASS=()
while [ $# -gt 0 ]; do
  case "$1" in
    status|restart|stop|clean) CMD="$1"; shift ;;
    --port)      PORT="${2:?--port necesita valor}"; PASS+=("$1" "$2"); shift 2 ;;
    --port=*)    PORT="${1#*=}"; PASS+=("$1"); shift ;;
    --insecure)  INSECURE=1; PASS+=("$1"); shift ;;
    --fresh)     FRESH=1; PASS+=("$1"); shift ;;
    --no-tunnel) TUNNEL=0; PASS+=("$1"); shift ;;
    -h|--help)   sed -n '2,/^$/{s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    -*)          die 2 "opción desconocida: $1 (ver --help)" ;;
    *)           URL="$1"; PASS+=("$1"); shift ;;
  esac
done

if [ -z "$(find_chrome)" ]; then
  if [ "$CMD" = up ]; then client_main up "${PASS[@]}"; else client_main "$CMD" "${PASS[@]}"; fi
  exit $?
fi

case "$CMD" in
  status)  server_status ;;
  up)      server_up "$URL" "$INSECURE" "$FRESH" "$TUNNEL" ;;
  restart) say "  reiniciando Chrome y túnel…"; stop_chrome; stop_tunnel
           server_up "$URL" "$INSECURE" "$FRESH" "$TUNNEL" ;;
  stop)    stop_chrome; stop_tunnel; ok "Chrome de debug y túnel cerrados" ;;
  clean)   stop_chrome; stop_tunnel; rm -rf "$PROFILE_DST"; ok "cerrado todo y borrada la copia del perfil ($PROFILE_DST)" ;;
esac
